# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="YOUR_APP_URL_HERE"

# Multi-Model Consensus Keys (production via OpenRouter)
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY_HERE"
# Optional model overrides (defaults shown):
# OPENROUTER_VISION_MODEL="openai/gpt-4o"
# OPENROUTER_VISION_FALLBACK_MODEL="openai/gpt-4-turbo"
# OPENROUTER_CONSENSUS_MODEL="qwen/qwen-2.5-vl-72b-instruct"
GROQ_API_KEY="YOUR_GROQ_API_KEY_HERE"
MISTRAL_API_KEY="YOUR_MISTRAL_API_KEY_HERE"
DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY_HERE"
DASHSCOPE_API_KEY="YOUR_DASHSCOPE_API_KEY_HERE"
OPENAI_API_KEY="YOUR_OPENAI_API_KEY_HERE"
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY_HERE"

# PostgreSQL Database Connection String
DATABASE_URL="YOUR_DATABASE_URL_HERE"

# --- AR-29 Authentication / Session Security ---
# SESSION_SECRET: Server-side session signing/entropy secret. REQUIRED in
# production; startup crashes on placeholder/missing/CI-mock values.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="YOUR_SESSION_SECRET_HERE"
# Session cookie name (httpOnly; defaults to motormedic_session)
# AUTH_COOKIE_NAME="motormedic_session"
# Session lifetime in hours (drives cookie Max-Age; default 336 = 14 days)
# SESSION_TTL_HOURS="336"
# Cookie SameSite policy: "Lax" (default) or "Strict"
# AUTH_COOKIE_SAMESITE="Lax"
# Development-only demo/user seeding. Never effective in production.
# ENABLE_DEV_AUTH_SEED="true"

# --- DEP-2 one-time first-admin bootstrap ---
# When the users table is COMPLETELY empty at boot, the server reads these
# two vars, bcrypt-hashes the password, and creates exactly one
# system-admin. Permanently inert once any user exists.
# POST-BOOTSTRAP HYGIENE: once the Render logs confirm the first admin
# exists ("[bootstrap] Created first system-admin ..."), DELETE
# BOOTSTRAP_ADMIN_EMAIL and BOOTSTRAP_ADMIN_PASSWORD from the Render env
# dashboard. Leaving them set is harmless (inert) but deleting them is the
# documented practice.
# BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
# BOOTSTRAP_ADMIN_PASSWORD="a-strong-unique-password"

# Testing / QA Mode (Set to true to enable the verification and feedback loops)
VITE_TESTING_MODE="true"

# Resend API Key for automated and manual email alerts
RESEND_API_KEY="YOUR_RESEND_API_KEY_HERE"

# Square Configuration
# SQUARE_ENVIRONMENT: "sandbox" or "production". It MUST agree with the access
# token type; a mismatch refuses boot (sandbox token vs production, or live
# token vs sandbox), so real charges can never be silently dropped.
SQUARE_ENVIRONMENT="sandbox"
SQUARE_ACCESS_TOKEN="YOUR_SQUARE_ACCESS_TOKEN_HERE"
# Signature key + exact notification URL registered for the webhook subscription.
SQUARE_WEBHOOK_SIGNATURE_SECRET="YOUR_SQUARE_WEBHOOK_SIGNATURE_KEY_HERE"
SQUARE_WEBHOOK_NOTIFICATION_URL="https://YOUR_APP_URL_HERE/api/square/webhook"
# Required for orders/payment links/subscriptions.
SQUARE_LOCATION_ID="YOUR_SQUARE_LOCATION_ID_HERE"
# Storefront module catalog variations (one Square catalog variation per module)
SQUARE_PRICE_VIBRATION="YOUR_SQUARE_VIBRATION_ID_HERE"
SQUARE_PRICE_THERMOGRAPHY="YOUR_SQUARE_VIBRATION_ID_HERE"
SQUARE_PRICE_ULTRASOUND="YOUR_SQUARE_VIBRATION_ID_HERE"
SQUARE_PRICE_OIL="YOUR_SQUARE_VIBRATION_ID_HERE"
# Legacy plan variations
SQUARE_PLAN_STARTER="YOUR_SQUARE_PLAN_VARIATION_ID_HERE"
SQUARE_PLAN_PROFESSIONAL="YOUR_SQUARE_PLAN_VARIATION_ID_HERE"
SQUARE_PLAN_ENTERPRISE="YOUR_SQUARE_PLAN_VARIATION_ID_HERE"
# TEST-ONLY. Enables the offline checkout mock + unsigned-webhook path in a
# non-production boot. Production REFUSES to start when this is "true".
# SQUARE_TEST_MODE="false"

# --- Local dev only (NOT used in production) ---
# Set USE_LM_STUDIO=true to route /api/extract-vibration-image to localhost LM Studio
# USE_LM_STUDIO="false"
# LM_STUDIO_ENDPOINT="http://localhost:1234/v1/chat/completions"
# LM_STUDIO_MODEL="qwen2.5-vl-7b-instruct"


